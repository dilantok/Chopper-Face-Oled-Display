const unsigned char* rightFrames[] = { rightEye_open, eye_happyright };
const int exprCount = 2;
int exprIdx = 0;
void setup() {
  Serial.begin(115200);

  Wire.begin(21, 22);       
  Wire.setClock(100000);   

  display.begin(0x3C, true);
  display.clearDisplay();

}

void loop() {
  display.clearDisplay();

  // eyes (left 50x40 and right 50x40) - animasyonlu
  display.drawBitmap(10, 12, leftFrames[exprIdx], 50, 40, SH110X_WHITE);
  display.drawBitmap(68, 12, rightFrames[exprIdx], 50, 40, SH110X_WHITE);

  // nose (16x16) - sabit
  display.drawBitmap(56, 40, nose, 16, 16, SH110X_WHITE);

  display.display();

  // ifade değiştir
  exprIdx++;
  if (exprIdx >= exprCount) exprIdx = 0;

  delay(500); // 0.5 saniyede bir değişsin
}
